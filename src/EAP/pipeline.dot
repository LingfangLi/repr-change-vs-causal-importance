// EAP top-K edge attribution pipeline (same-task + cross-task + PT-vs-FT)
// Render: dot -Tpng pipeline.dot -o pipeline.png

digraph pipeline_eap {
    rankdir=TB;
    compound=true;
    graph [fontname="Helvetica", bgcolor="white", nodesep=0.3, ranksep=0.45];
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    // ============ Inputs ============
    subgraph cluster_input {
        label=<<B>Inputs</B>>;
        fontsize=12; color="#888888"; style="dashed";

        model  [label="Model\n(base PT or FT)", shape=cylinder, fillcolor="#D1E8FF"];
        clean  [label="Clean batch\n(task-A prompts + labels)", shape=folder, fillcolor="#D1E8FF"];
        corr_same [label="Corrupted batch — same-task\n(task-A prompts with label-flipped\nor semantically-opposed pairs)", shape=folder, fillcolor="#D1E8FF"];
        corr_cross [label="Corrupted batch — cross-task\n(task-B data, for cross-task runs)", shape=folder, fillcolor="#D1E8FF"];
    }

    // ============ Step 1: forward both and measure metric gap ============
    subgraph cluster_metric {
        label=<<B>Step 1 &nbsp; Measure baseline vs corrupted</B>>;
        fontsize=12; color="#4A90E2"; style="rounded";

        fwd_clean [label="Forward(clean)\n→ logits_clean", fillcolor="#E8F4FD"];
        fwd_corr  [label="Forward(corrupted)\n→ logits_corrupted", fillcolor="#E8F4FD"];
        metric    [label="metric = prob_diff(\n  logits_clean, logits_corrupted, labels\n)\n= 'how much does corrupting hurt\n   the label probability?'", fillcolor="#E8F4FD"];

        fwd_clean -> metric;
        fwd_corr  -> metric;
    }

    model -> fwd_clean [lhead=cluster_metric];
    clean -> fwd_clean;
    corr_same -> fwd_corr [label="same-task"];
    corr_cross -> fwd_corr [label="cross-task\n(alternative)"];

    // ============ Step 2: attribution ============
    subgraph cluster_attr {
        label=<<B>Step 2 &nbsp; Edge attribution patching</B>>;
        fontsize=12; color="#4A90E2"; style="rounded";

        graph_init [label="Build computation graph\n(attn-heads × layers + MLPs\n+ input/output nodes)\nedges = potential information flows", fillcolor="#E8F4FD"];
        backward   [label="Backward pass at each edge\n→ gradient × activation diff\n= attribution score per edge\n(EAP-positional package)", fillcolor="#E8F4FD"];
        score_all  [label="|score| for every edge\n(edge count ≈ 10^5 for Llama-2)", shape=folder, fillcolor="#C9E7CA"];

        graph_init -> backward -> score_all;
    }

    metric -> graph_init [ltail=cluster_metric, lhead=cluster_attr];

    // ============ Step 3: threshold ============
    subgraph cluster_pick {
        label=<<B>Step 3 &nbsp; Hard top-K cutoff</B>>;
        fontsize=12; color="#F5A623"; style="rounded";

        sort [label="Sort |score| descending", fillcolor="#FFF3E0"];
        thr  [label="threshold = scores[-top_k]\n(default top_k = 400)\nfilter graph → only keep edges\nwith |score| ≥ threshold", fillcolor="#FFF3E0"];
        out_edges [label="Top-K edges\n+ score, source, target", shape=folder, fillcolor="#C9E7CA"];

        sort -> thr -> out_edges;
    }

    score_all -> sort [ltail=cluster_attr, lhead=cluster_pick];

    // ============ Outputs ============
    subgraph cluster_out {
        label=<<B>Outputs &nbsp; output/EAP_edges/</B>>;
        fontsize=12; color="#888888"; style="dashed";

        ft_csv [label="finetuned/\nllama2_{task}_finetuned_edges.csv\n(same-task FT)", shape=note, fillcolor="#FFFDE7"];
        pt_csv [label="pretrained/\nllama2_{task}_pretrained_edges.csv\n(same-task base)", shape=note, fillcolor="#FFFDE7"];
        cross  [label="cross_task_edges/\nllama2_Finetuned-{A}_Corrupted-Data_{B}\n_finetuned_edges.csv", shape=note, fillcolor="#FFFDE7"];
        overlap [label="overlap/\nllama2_{task}_overlap.csv\n(PT vs FT Jaccard)", shape=note, fillcolor="#FFFDE7"];
        top2k  [label="finetuned_top2000/\nllama2_{task}_finetuned_edges.csv\n(same run, top_k=2000)", shape=note, fillcolor="#FFFDE7"];
    }

    out_edges -> ft_csv  [style=dashed, label="corr = same task,\nFT model"];
    out_edges -> pt_csv  [style=dashed, label="corr = same task,\nbase model"];
    out_edges -> cross   [style=dashed, label="corr = task B"];
    out_edges -> top2k   [style=dashed, label="rerun with\ntop_k=2000"];
    ft_csv -> overlap    [style=dashed, label="compare with\npt_csv edge set"];
    pt_csv -> overlap    [style=dashed];
}
