// Component distribution pipeline — categorize top-K EAP edges
// Render: dot -Tpng pipeline.dot -o pipeline.png

digraph pipeline_component {
    rankdir=TB;
    compound=true;
    graph [fontname="Helvetica", bgcolor="white", nodesep=0.3, ranksep=0.45];
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    // ============ Input ============
    subgraph cluster_input {
        label=<<B>Input</B>>;
        fontsize=12; color="#888888"; style="dashed";

        csv [label="Top-K EAP edges CSV\n(from EAP pipeline, top_k=400)\ne.g. llama2_sst2_finetuned_edges.csv\ncolumns: edge, score", shape=cylinder, fillcolor="#D1E8FF"];
    }

    // ============ Step 1: parse edge strings ============
    subgraph cluster_parse {
        label=<<B>Step 1 &nbsp; Parse each edge string</B>>;
        fontsize=12; color="#4A90E2"; style="rounded";

        example [label="Edge string examples:\n  'a5.h14 → a12.h3 &lt;k&gt;'   (head → head, key side)\n  'm1 → a8.h12 &lt;q&gt;'       (MLP → head, query side)\n  'm7 → m19'                  (MLP → MLP)\n  'input → a2.h26 &lt;v&gt;'    (input token → head value)\n  'm26 → logits'              (MLP → final output)", fillcolor="#E8F4FD", shape=note];

        regex [label="Regex match endpoints\n  a(L).h(H)   — attention head at layer L, head H\n  m(L)        — MLP at layer L\n  input       — input token embedding\n  logits      — final output projection", fillcolor="#E8F4FD"];
    }

    csv -> example [lhead=cluster_parse];
    example -> regex;

    // ============ Step 2: count per category ============
    subgraph cluster_count {
        label=<<B>Step 2 &nbsp; Categorize + count</B>>;
        fontsize=12; color="#F5A623"; style="rounded";

        bin [label="For each edge, classify both endpoints into:\n  {Attn Head (layer), MLP (layer), Input, Logits}\nCount frequency per bin", fillcolor="#FFF3E0"];

        agg [label="Per-task aggregate\n= how many top-400 edges\n  touch each component type\n  at each layer depth", shape=folder, fillcolor="#C9E7CA"];

        bin -> agg;
    }

    regex -> bin [ltail=cluster_parse, lhead=cluster_count];

    // ============ Step 3: plot ============
    subgraph cluster_plot {
        label=<<B>Step 3 &nbsp; Plot</B>>;
        fontsize=12; color="#7ED321"; style="rounded";

        plot [label="Bar/stacked plot:\nx = layer or component type,\ny = count\none figure per (model, task)", fillcolor="#F0F9E8"];
    }

    agg -> plot [ltail=cluster_count, lhead=cluster_plot];

    // ============ Output ============
    subgraph cluster_out {
        label=<<B>Outputs &nbsp; experiments/component_distribution/</B>>;
        fontsize=12; color="#888888"; style="dashed";

        pdf_llama2 [label="figure/\nllama2_{task}_top_400_edges_\ncomponent_distribution.pdf\n(6 tasks)", shape=note, fillcolor="#FFFDE7"];
        pdf_others [label="figure/\ngpt2_* / llama3.2_* / qwen2_*\ncomponent_distribution.pdf\n(other models for comparison)", shape=note, fillcolor="#FFFDE7"];
        combined   [label="figure/\ngpt2_combined_paper.pdf\n(all tasks in one panel for paper)", shape=note, fillcolor="#FFFDE7"];
    }

    plot -> pdf_llama2  [style=dashed];
    plot -> pdf_others  [style=dashed];
    plot -> combined    [style=dashed, label="gpt2 only,\n6-task panel"];
}
