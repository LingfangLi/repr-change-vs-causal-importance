// Induction head detection + overlap analysis pipeline
// Render: dot -Tpng pipeline.dot -o pipeline.png

digraph pipeline_induction {
    rankdir=TB;
    compound=true;
    graph [fontname="Helvetica", bgcolor="white", nodesep=0.3, ranksep=0.45];
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    // ============ Inputs ============
    subgraph cluster_input {
        label=<<B>Inputs</B>>;
        fontsize=12;
        color="#888888";
        style="dashed";

        base  [label="Base model\nLlama-2-7B", shape=cylinder, fillcolor="#D1E8FF"];
        ft    [label="6 FT models\nllama2-7b-{task}-full", shape=cylinder, fillcolor="#D1E8FF"];
        eap   [label="EAP edge CSVs\n(for overlap step)\noutput/EAP_edges/finetuned/", shape=cylinder, fillcolor="#D1E8FF"];
    }

    // ============ Step 1: score all heads ============
    subgraph cluster_score {
        label=<<B>Step 1 &nbsp; Score every head</B>>;
        fontsize=12;
        color="#4A90E2";
        style="rounded";

        synth   [label="Build synthetic sequence\nR = 50 random tokens\ninput = R + R (length 100)", fillcolor="#E8F4FD"];
        forward [label="Forward pass\n+ cache attention patterns\n(TransformerLens)", fillcolor="#E8F4FD"];
        calc    [label="For each head (L, H):\nscore = mean over second half of\n  attn[i,  i - 49]\n= 'how much does this head\n   attend to the right copy-source?'", fillcolor="#E8F4FD"];
        matrix  [label="32 × 32 score matrix\n(all 1024 heads)", shape=folder, fillcolor="#C9E7CA"];

        synth -> forward -> calc -> matrix;
    }

    base -> synth [lhead=cluster_score];
    ft   -> synth [lhead=cluster_score];

    // ============ Step 2: pick which are induction heads ============
    subgraph cluster_select {
        label=<<B>Step 2 &nbsp; Adaptive head selection</B>>;
        fontsize=12;
        color="#F5A623";
        style="rounded";

        sort   [label="Sort all 1024 scores\ndescending", fillcolor="#FFF3E0"];
        rules  [label="Combine 3 rules\nk = max(\n  min(elbow_idx, #{score>0.1}),\n  #{score>0.3}\n)", fillcolor="#FFF3E0"];
        select [label="Selected k induction heads\nper task", shape=folder, fillcolor="#C9E7CA"];

        sort -> rules -> select;
    }

    matrix -> sort [ltail=cluster_score, lhead=cluster_select];

    // ============ Step 3: overlap with EAP ============
    subgraph cluster_overlap {
        label=<<B>Step 3 &nbsp; Overlap with EAP top-400 heads</B>>;
        fontsize=12;
        color="#7ED321";
        style="rounded";

        parse   [label="Parse edge CSV → extract\nheads matching 'a(L).h(H)'\nfor each edge", fillcolor="#F0F9E8"];
        eapset  [label="EAP-important head set", shape=folder, fillcolor="#C9E7CA"];
        inter   [label="Intersect with induction set\n\nRecall    = |∩| / |induction|\nPrecision = |∩| / |EAP|", fillcolor="#F0F9E8"];
        scatter [label="Per-task scatter:\ninduction score  vs  EAP importance", fillcolor="#F0F9E8"];

        parse -> eapset -> inter;
        eapset -> scatter;
    }

    eap    -> parse  [lhead=cluster_overlap];
    select -> inter  [ltail=cluster_select];
    select -> scatter;

    // ============ Outputs ============
    subgraph cluster_out {
        label=<<B>Outputs &nbsp; experiments/induction_head/</B>>;
        fontsize=12;
        color="#888888";
        style="dashed";

        npy     [label="output/llama2/\ninduction_scores_{status}_{task}.npy", shape=note, fillcolor="#FFFDE7"];
        det     [label="output/llama2/\ndetected_heads_{status}_{task}.json\n(k + (L,H,score) list)", shape=note, fillcolor="#FFFDE7"];
        heat    [label="output/llama2/\nheatmap + analysis PNG", shape=note, fillcolor="#FFFDE7"];
        sct     [label="output/llama2/\nscatter_{task}.pdf / png", shape=note, fillcolor="#FFFDE7"];
        ovstat  [label="output/\ninduction_overlap_stats_edges400.csv", shape=note, fillcolor="#FFFDE7"];
        sweep   [label="output/\ninduction_overlap_topK_sweep.csv", shape=note, fillcolor="#FFFDE7"];
    }

    matrix  -> npy  [style=dashed];
    matrix  -> heat [style=dashed];
    select  -> det  [style=dashed];
    inter   -> ovstat [style=dashed];
    scatter -> sct  [style=dashed];
    inter   -> sweep  [style=dashed, label="repeat at\nK=1000/2000/5000"];
}
