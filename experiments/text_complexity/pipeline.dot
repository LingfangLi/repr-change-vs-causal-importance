// Text complexity 3×3 controlled FT pipeline
// Render: dot -Tpng pipeline.dot -o pipeline.png

digraph pipeline_tc {
    rankdir=TB;
    compound=true;
    graph [fontname="Helvetica", bgcolor="white", nodesep=0.3, ranksep=0.45];
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    // ============ Inputs ============
    subgraph cluster_input {
        label=<<B>Inputs</B>>;
        fontsize=12; color="#888888"; style="dashed";

        raw [label="Raw datasets\n• yelp_polarity\n• squad\n• tatoeba (en-fr)", shape=cylinder, fillcolor="#D1E8FF"];
        llama [label="Base model\nLlama-2-7B", shape=cylinder, fillcolor="#D1E8FF"];
    }

    // ============ Step 1: complexity scoring ============
    subgraph cluster_score {
        label=<<B>Step 1 &nbsp; Lexical complexity scoring</B>>;
        fontsize=12; color="#4A90E2"; style="rounded";

        stanza [label="Run stanza on each sample\n(run_complexity.py)\n→ per-sample readability score\n(lexical diversity, sentence length,\n rare-word ratio)", fillcolor="#E8F4FD"];

        split_idx [label="Split into two subsets by score:\n  • lexically simple (bottom 50%)\n  • lexically complex (top 50%)\nSave subset indices as .txt", fillcolor="#E8F4FD"];

        stanza -> split_idx;
    }

    raw -> stanza [lhead=cluster_score];

    // Idx files output
    idx [label="matrix_analysis/\n{task}_lexically_simple_subset_indices.txt\n{task}_lexically_complex_subset_indices.txt\n(+ same for test splits)", shape=folder, fillcolor="#C9E7CA"];
    split_idx -> idx;

    // ============ Step 2: Fine-tune 3 variants per task ============
    subgraph cluster_train {
        label=<<B>Step 2 &nbsp; Train 3 variants × 3 tasks = 9 models</B>>;
        fontsize=12; color="#F5A623"; style="rounded";

        train_table [label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
            <TR><TD BGCOLOR="#FFD9B3"><B>Train variant</B></TD><TD BGCOLOR="#FFD9B3"><B>Description</B></TD></TR>
            <TR><TD>base</TD><TD>Zero-shot, no FT</TD></TR>
            <TR><TD>simple-FT</TD><TD>Full FT on lexically simple subset</TD></TR>
            <TR><TD>complex-FT</TD><TD>Full FT on lexically complex subset</TD></TR>
          </TABLE>
        >, shape=plaintext];

        train_scripts [label="llama2_{sentiment,qa,mt}_train_full.py\n(launched by submit_tc_full_ft_train.sh)", fillcolor="#FFF3E0"];

        ft_out [label="FT checkpoints\n(simple / complex, per task)", shape=folder, fillcolor="#C9E7CA"];

        train_table -> train_scripts [style=invis];
        train_scripts -> ft_out;
    }

    idx -> train_scripts [ltail=cluster_score];
    llama -> train_scripts;

    // ============ Step 3: Eval on both test splits ============
    subgraph cluster_eval {
        label=<<B>Step 3 &nbsp; Evaluate every model on every test split</B>>;
        fontsize=12; color="#7ED321"; style="rounded";

        matrix_lbl [label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
            <TR><TD BGCOLOR="#D6F5D0"></TD><TD BGCOLOR="#D6F5D0"><B>test_simple</B></TD><TD BGCOLOR="#D6F5D0"><B>test_complex</B></TD></TR>
            <TR><TD BGCOLOR="#D6F5D0"><B>base</B></TD><TD>•</TD><TD>•</TD></TR>
            <TR><TD BGCOLOR="#D6F5D0"><B>simple-FT</B></TD><TD>•</TD><TD>•</TD></TR>
            <TR><TD BGCOLOR="#D6F5D0"><B>complex-FT</B></TD><TD>•</TD><TD>•</TD></TR>
          </TABLE>
        >, shape=plaintext];

        eval_scripts [label="llama2_{sentiment,qa,mt}_eval_full.py\n(launched by submit_tc_full_ft_eval.sh)\nmetric: accuracy (yelp) / F1+EM (squad) / BLEU (tatoeba)", fillcolor="#F0F9E8"];

        per_run [label="per-run eval JSON:\neval_results_{task}_train_{S}_test_{T}_full.json\n(6 files per task × 3 tasks = 18 files)", shape=folder, fillcolor="#C9E7CA"];

        matrix_lbl -> eval_scripts [style=invis];
        eval_scripts -> per_run;
    }

    ft_out -> eval_scripts [ltail=cluster_train, lhead=cluster_eval];

    // ============ Step 4: Aggregate ============
    subgraph cluster_agg {
        label=<<B>Step 4 &nbsp; Aggregate</B>>;
        fontsize=12; color="#888888"; style="rounded,dashed";

        agg [label="aggregate_eval_results.py\n→ summary_long.csv  (tidy long format)\n→ summary_wide.csv  (wide/pivot)\n→ summary.tex       (LaTeX table)", fillcolor="#F5F5F5"];
    }

    per_run -> agg [ltail=cluster_eval, lhead=cluster_agg];

    // ============ Outputs ============
    subgraph cluster_out {
        label=<<B>Outputs &nbsp; experiments/text_complexity/fine_tune/results_full/</B>>;
        fontsize=12; color="#888888"; style="dashed";

        long [label="summary_long.csv", shape=note, fillcolor="#FFFDE7"];
        wide [label="summary_wide.csv", shape=note, fillcolor="#FFFDE7"];
        tex  [label="summary.tex", shape=note, fillcolor="#FFFDE7"];
        jsons [label="eval_results_*.json\n(18 raw files)", shape=note, fillcolor="#FFFDE7"];
    }

    agg -> long [style=dashed];
    agg -> wide [style=dashed];
    agg -> tex  [style=dashed];
    per_run -> jsons [style=dashed];
}
